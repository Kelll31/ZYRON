{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "ZYRON_ENABLE_TESTS": "ON" }
    },
    {
      "name": "base-ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "base-macos",
      "hidden": true,
      "inherits": "base-ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "base-linux",
      "hidden": true,
      "inherits": "base-ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    { "name": "windows-debug", "displayName": "Windows (MSVC) Debug", "inherits": "base-windows" },
    { "name": "windows-release", "displayName": "Windows (MSVC) Release", "inherits": "base-windows" },
    {
      "name": "macos-debug",
      "displayName": "macOS (Clang) Debug",
      "inherits": "base-macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS (Clang) Release",
      "inherits": "base-macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux (GCC/Clang) Debug",
      "inherits": "base-linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (GCC/Clang) Release",
      "inherits": "base-linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "windows-debug", "inherits": "base-test", "configurePreset": "windows-debug", "configuration": "Debug" },
    { "name": "windows-release", "inherits": "base-test", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "macos-debug", "inherits": "base-test", "configurePreset": "macos-debug" },
    { "name": "macos-release", "inherits": "base-test", "configurePreset": "macos-release" },
    { "name": "linux-debug", "inherits": "base-test", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "base-test", "configurePreset": "linux-release" }
  ]
}
